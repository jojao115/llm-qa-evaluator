# Copie para .env. Sem chave de API, deixe LLM_PROVEDOR=simulado: a API sobe e responde
# com a heurística por palavras-chave, sem custo.
LLM_PROVEDOR=simulado

# Para usar o Claude: LLM_PROVEDOR=anthropic e a chave abaixo.
# ANTHROPIC_API_KEY=
LLM_MODELO=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_ESFORCO=medium
MAX_TENTATIVAS=3

LOTE_CONCORRENCIA=4
LOTE_MAX_CONVERSAS=200
# Conversas esperando na fila, somando todos os lotes. Acima disso, POST /lotes devolve 503.
LOTE_FILA_MAX=2000
